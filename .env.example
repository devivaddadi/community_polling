# Firebase Configuration Template
# Copy this file to .env or pass these as --dart-define flags when building/running.
# NEVER commit your real .env or secrets to Git!

FIREBASE_API_KEY=AIzaSyYourApiKeyHere
FIREBASE_PROJECT_ID=your-community-project
FIREBASE_DATABASE_URL=https://your-community-project-default-rtdb.firebaseio.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-community-project.firebasestorage.app
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000000000
